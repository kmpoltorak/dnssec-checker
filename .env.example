# Resolver the web interface fetches records from, as for --resolver: an IP address
# with an optional port, or tls://IP[:port][#name] for DNS over TLS. Validation is done
# locally, so the resolver only fetches records. Docker's built-in DNS drops DNSSEC
# records and cannot be used. Default: Quad9 over TLS.
DNSSEC_RESOLVER=tls://9.9.9.9
# Your own resolver, for example: DNSSEC_RESOLVER=tls://192.0.2.53#dns.example.net

# Port on 127.0.0.1 where the web interface is published.
PORT=8080
